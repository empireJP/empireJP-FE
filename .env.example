# Copy to .env.local. Every var here is NEXT_PUBLIC_*, i.e. inlined into the
# client bundle at build time — never put a secret in this file.

# BE origin — /api/auth (better-auth) and /api/v1/* both live here.
# The BE must list this app's origin in its FRONTEND_ORIGINS, or the browser
# blocks every client-side call to it (server components are unaffected, which
# is what makes the failure look like an empty page rather than an error).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Logging -----------------------------------------------------------------
# Deployment stage: local | dev | prod. Stamped on every log line and picks the
# default level below.
NEXT_PUBLIC_APP_ENV=local

# trace | debug | info | warn | error | silent
# Unset = derived from the stage: prod -> warn, local/dev -> debug.
# NEXT_PUBLIC_LOG_LEVEL=debug
